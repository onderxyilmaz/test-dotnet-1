<Window x:Class="BasitWindowsUygulamasi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BasitWindowsUygulamasi"
        mc:Ignorable="d"
        Title="Basit Windows Uygulaması"
        Height="515"
        Width="560"
        MinHeight="470"
        MinWidth="460"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded"
        Background="#DFE9F9">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Hoş geldiniz"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#222" />
            <TextBlock x:Name="SurumKimligiMetni"
                       Margin="0,10,0,0"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#0D47A1"
                       Text="Sürüm —" />
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,24"
                   TextWrapping="Wrap"
                   Foreground="#555"
                   FontSize="14"
                   Text="Bu proje sisteminizde kurulu olan .NET 10 ile oluşturulmuş basit bir WPF masaüstü uygulamasıdır." />

        <Border Grid.Row="2"
                MinHeight="150"
                Background="#FFFFFF"
                CornerRadius="8"
                Padding="20"
                VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="15"
                           Foreground="#444"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="Artır ve azalt düğmeleriyle sayacı değiştirebilirsiniz." />
                <TextBlock x:Name="SayacMetni"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="#1565C0"
                           Text="0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
            <Button x:Name="AzaltButonu"
                    Padding="20,12"
                    FontSize="15"
                    Content="Sayacı azalt"
                    IsEnabled="False"
                    Click="AzaltButonu_Click" />
            <Button x:Name="ArtirButonu"
                    Margin="12,0,0,0"
                    Padding="24,12"
                    FontSize="15"
                    Content="Sayacı artır"
                    Click="ArtirButonu_Click" />
            <Button x:Name="GuncellemeKontrolButonu"
                    Margin="12,0,0,0"
                    Padding="24,12"
                    FontSize="15"
                    Content="Güncellemeleri kontrol et"
                    Click="GuncellemeKontrolButonu_Click" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   x:Name="GuncellemeDurumu"
                   Margin="0,16,0,0"
                   FontSize="12"
                   Foreground="#666"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
